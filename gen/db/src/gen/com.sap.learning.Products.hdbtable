COLUMN TABLE com_sap_learning_Products (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  Name NVARCHAR(45),
  Price_amount DECIMAL,
  Price_currency NVARCHAR(3) DEFAULT 'USD',
  Photo NVARCHAR(100),
  Specs NVARCHAR(2000),
  Rating INTEGER,
  SupplierInfo NVARCHAR(2000),
  MadeIn NVARCHAR(45),
  ProductionCompanyName NVARCHAR(100),
  Status NVARCHAR(100),
  Store_ID NVARCHAR(36),
  PRIMARY KEY(ID)
) WITH ASSOCIATIONS (
  MANY TO MANY JOIN com_sap_learning_ProductComments AS Comment ON (Comment.Product_ID = ID),
  MANY TO ONE JOIN com_sap_learning_Stores AS Store ON (Store.ID = Store_ID)
)