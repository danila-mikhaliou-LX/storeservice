VIEW StoreService_Products AS SELECT
  Products_0.ID,
  Products_0.createdAt,
  Products_0.createdBy,
  Products_0.modifiedAt,
  Products_0.modifiedBy,
  Products_0.Name,
  Products_0.Price_amount,
  Products_0.Price_currency,
  Products_0.Photo,
  Products_0.Specs,
  Products_0.Rating,
  Products_0.SupplierInfo,
  Products_0.MadeIn,
  Products_0.ProductionCompanyName,
  Products_0.Status,
  Products_0.Store_ID
FROM com_sap_learning_Products AS Products_0
WITH ASSOCIATIONS (
  MANY TO MANY JOIN StoreService_ProductComments AS Comment ON (Comment.Product_ID = ID),
  MANY TO ONE JOIN StoreService_Stores AS Store ON (Store.ID = Store_ID)
)