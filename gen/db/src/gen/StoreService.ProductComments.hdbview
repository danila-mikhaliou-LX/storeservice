VIEW StoreService_ProductComments AS SELECT
  ProductComments_0.ID,
  ProductComments_0.createdAt,
  ProductComments_0.createdBy,
  ProductComments_0.modifiedAt,
  ProductComments_0.modifiedBy,
  ProductComments_0.Author,
  ProductComments_0.Message,
  ProductComments_0.Rating,
  ProductComments_0.Posted,
  ProductComments_0.Product_ID
FROM com_sap_learning_ProductComments AS ProductComments_0
WITH ASSOCIATIONS (
  MANY TO ONE JOIN StoreService_Products AS "PRODUCT" ON ("PRODUCT".ID = Product_ID)
)