{
  "name": "storeservice",
  "version": "0.0.1",
  "description": "Build and deployment scripts",
  "dependencies": {
    "@sap/cds": "^8",
    "@sap/cds-odata-v2-adapter-proxy": "^1.9.21",
    "express": "^4.21.2"
  },
  "scripts": {
    "clean": "rimraf --glob resources mta_archives mta-op*",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "undeploy": "cf undeploy storeservice --delete-services --delete-service-keys --delete-service-brokers",
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy:db": "rm -rf db.sqlite && cds deploy"
  },
  "devDependencies": {
    "mbt": "^1.2.29",
    "rimraf": "^6.0.1",
    "@cap-js/cds-types": "^0.9.0",
    "@cap-js/sqlite": "^1.8.0"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        }
      }
    }
  },
  "engines": {
    "node": ">=20"
  }
}