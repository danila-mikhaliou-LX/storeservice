{
  "name": "storeservice",
  "version": "0.0.1",
  "description": "Build and deployment scripts",
  "dependencies": {
    "@sap/cds": "^8",
    "@sap/cds-odata-v2-adapter-proxy": "^1.9.21",
    "@sap/hana-client": "^2.27.23",
    "@sap/xsenv": "^6.1.0",
    "@sap/xssec": "^4.12.2",
    "express": "^4.21.2",
    "passport": "^0.7.0"
  },
  "scripts": {
    "clean": "rimraf --glob resources mta_archives mta-op*",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "undeploy": "cf undeploy storeservice --delete-services --delete-service-keys --delete-service-brokers",
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy:db": "rm -rf db.sqlite && cds deploy",
    "watch-storeservice": "cds watch --open storeservice/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.9.0",
    "@cap-js/sqlite": "^1.8.0",
    "@sap/cds-dk": "^8",
    "mbt": "^1.2.29",
    "rimraf": "^6.0.1"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana",
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        }
      }
    }
  },
  "sapux": [
    "app/storeservice"
  ],
  "engines": {
    "node": ">=20"
  }
}