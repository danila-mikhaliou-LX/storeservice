{
	"_version": "1.81.0",
	"sap.app": {
		"id": "storeservice",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:lrop",
			"version": "1.20.2",
			"toolsId": "b208021b-3c96-452b-911a-2c72eca4d38e"
		},
		"dataSources": {
			"mainService": {
				"uri": "/root/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"storeservice-maintain": {
					"semanticObject": "storeservice",
					"action": "maintain",
					"title": "{{storeservice-maintain.flpTitle}}",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.144.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "storeservice.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties",
				"settings": {
					"supportedLocales": [
						""
					]
				}
			}
		},
		"resources": {
			"css": []
		},
		"routing": {
			"config": {},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "StoresList",
					"target": "StoresList"
				},
				{
					"pattern": "Stores({key}):?query:",
					"name": "StoresObjectPage",
					"target": "StoresObjectPage"
				},
				{
					"pattern": "Stores({key})/Products({key2}):?query:",
					"name": "ProductsObjectPage",
					"target": "ProductsObjectPage"
				}
			],
			"targets": {
				"StoresList": {
					"type": "Component",
					"id": "StoresList",
					"name": "sap.fe.templates.ListReport",
					"options": {
						"settings": {
							"contextPath": "/Stores",
							"variantManagement": "Page",
							"navigation": {
								"Stores": {
									"detail": {
										"route": "StoresObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									},
									"columns": {
										"DataField::Name": {
											"width": "20%"
										},
										"DataField::Address": {
											"width": "20%"
										},
										"DataField::Established": {
											"width": "20%"
										},
										"DataField::Email": {
											"width": "20%"
										},
										"DataField::PhoneNumber": {
											"width": "20%"
										}
									}
								}
							},
							"initialLoad": "Enabled"
						}
					}
				},
				"StoresObjectPage": {
					"type": "Component",
					"id": "StoresObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/Stores",
							"navigation": {
								"Products": {
									"detail": {
										"route": "ProductsObjectPage"
									}
								}
							},
							"sectionLayout": "Page",
							"controlConfiguration": {
								"Products/@com.sap.vocabularies.UI.v1.LineItem#Products": {
									"columns": {
										"DataField::Name": {
											"width": "10%"
										},
										"DataField::Specs": {
											"width": "12%"
										},
										"DataField::SupplierInfo": {
											"width": "12%"
										},
										"DataField::ProductionCompanyName": {
											"width": "10%"
										},
										"DataField::Price_amount": {
											"width": "10%"
										},
										"DataField::Price_currency": {
											"width": "10%"
										},
										"DataField::MadeIn": {
											"width": "10%"
										},
										"DataFieldForAnnotation::DataPoint::Rating": {
											"width": "15%"
										},
										"SpecsCustomColomn": {
											"header": "{i18n>specs}",
											"width": "12%",
											"position": {
												"anchor": "DataFieldForAnnotation::DataPoint::Rating",
												"placement": "After"
											},
											"template": "storeservice.ext.fragment.SpecsCustomColomn"
										},
										"SupplierInfoCustomColomn": {
											"header": "{i18n>supplierInfo}",
											"width": "12%",
											"position": {
												"anchor": "SpecsCustomColomn",
												"placement": "After"
											},
											"template": "storeservice.ext.fragment.SupplierInfoCustomColomn"
										},
										"StatusCustomColomn": {
											"header": "{i18n>status}",
											"width": "12%",
											"position": {
												"anchor": "DataFieldForAnnotation::DataPoint::Rating",
												"placement": "After"
											},
											"template": "storeservice.ext.fragment.StatusCustomColomn"
										}
									}
								}
							}
						}
					}
				},
				"ProductsObjectPage": {
					"type": "Component",
					"id": "ProductsObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/Stores/Products",
							"content": {
								"body": {
									"sections": {
										"FeedbackCustomControl": {
											"template": "storeservice.ext.fragment.FeedbackCustomControl",
											"position": {
												"placement": "After",
												"anchor": "ProductInfo"
											},
											"title": "{i18n>feedback}"
										}
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.FieldGroup#ProductInfo": {
									"fields": {
										"StatusCustomColomn": {
											"template": "storeservice.ext.fragment.StatusCustomColomn",
											"position": {
												"placement": "After",
												"anchor": "DataField::Name"
											},
											"label": "{i18n>status}"
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"flexBundle": false
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.fe": {
		"app": {
			"enableLazyLoading": true
		}
	},
	"sap.cloud": {
		"public": true,
		"service": "storeservice"
	}
}